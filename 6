#include <iostream>
using namespace std;

int main() {
    int d1, m1, d2, m2;
    int dias_fecha1, dias_fecha2, diferencia_total, meses_res, dias_res;

    cout << "Fecha inicial (DD MM): "; cin >> d1 >> m1;
    cout << "Fecha final (DD MM): "; cin >> d2 >> m2;

    // Convertimos cada fecha a días totales (asumiendo meses de 30 días)
    dias_fecha1 = (m1 * 30) + d1;
    dias_fecha2 = (m2 * 30) + d2;

    diferencia_total = dias_fecha2 - dias_fecha1;

    meses_res = diferencia_total / 30;
    dias_res = diferencia_total % 30;

    cout << "Diferencia: " << meses_res << " meses y " << dias_res << " dias." << endl;
    return 0;
}
