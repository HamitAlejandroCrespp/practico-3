#include <iostream>
#include <string>
using namespace std;

int main() {
    string nombre;
    float salario, aguinaldo;
    int meses;

    cout << "Ingrese nombre del trabajador: "; 
    cin >> nombre;
    cout << "Ingrese salario mensual: "; 
    cin >> salario;
    cout << "Ingrese meses trabajados en el año (1-12): "; 
    cin >> meses;

    aguinaldo = (salario * meses) / 12.0;

    cout << "El aguinaldo de " << nombre << " es: " << aguinaldo << " Bs." << endl;
    return 0;
}
